# Python environment (conda env "affordance3d", see requirements.txt)
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.virtual_documents/

# Local datasets, third-party checkouts and experiment outputs are not versioned.
# Leading slashes keep these from matching the tracked docs/outputs/ folder; no trailing slash, so that
# a symlink to a data disk (as on the A6000 server, see scripts/remote/) is ignored as well.
/data
/third_party
/runs

# Report media: the videos made by the report notebooks are tracked in report/assets, so that a clone
# has them for presentations. The official preview images are fetched with
# scripts/download_report_images.sh (third-party, not redistributed here).
/report/assets/external

.DS_Store
